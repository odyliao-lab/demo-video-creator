# === API Keys（執行必填）===
# Anthropic API key: https://platform.claude.com/ -> API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Gemini API key: https://aistudio.google.com/apikey （有免費層）
GEMINI_API_KEY=...

# === 模型設定（可不改，以下為預設值）===
# 影片理解（Gemini，原生支援影片輸入）
ANALYZER_MODEL=gemini-2.5-flash
# 企劃/分鏡生成（預設 Sonnet 5，Phase 1 足夠且便宜）
PLANNER_MODEL=claude-sonnet-5
# 當 PLANNER_MODEL 輸出驗證失敗/被拒絕時，自動升級到此模型重試
PLANNER_ESCALATION_MODEL=claude-opus-5

# === Phase 2：影片生成（付費）===
# 供應商：fal（Seedance/Kling，便宜 10-30 倍，預設）或 veo（Gemini API）
VIDEO_PROVIDER=fal

# --- fal.ai（VIDEO_PROVIDER=fal 時使用）---
# API key: https://fal.ai/dashboard/keys
FAL_KEY=...
# 模型 endpoint id，可選：
#   bytedance/seedance-2.0/fast/text-to-video   （最便宜，預設）
#   bytedance/seedance-2.0/text-to-video        （Seedance 標準版）
#   fal-ai/kling-video/v3/standard/text-to-video（Kling 3.0）
#   fal-ai/kling-video/v3/pro/text-to-video     （Kling 3.0 Pro）
FAL_MODEL=bytedance/seedance-2.0/fast/text-to-video

# --- Veo（VIDEO_PROVIDER=veo 時使用，走 GEMINI_API_KEY）---
VIDEO_MODEL=veo-3.1-generate-preview

VIDEO_RESOLUTION=720p
# 所選模型的每秒單價（美元），用於生成前成本預估；請至供應商定價頁查詢後填入
# 參考量級：Seedance 2.0 Fast ~0.022 / Kling 3.0 ~0.029 / Veo 3.1 Fast ~0.15
# VIDEO_PRICE_PER_SECOND=0.022
# 單批最多生成鏡頭數（成本護欄）
MAX_SHOTS_PER_BATCH=5

# === 路徑 ===
# 工作目錄（影格、輸出、資料庫），預設為專案下 workspace/
# WORKSPACE_DIR=M:/AI_Dev/demo-video-creator/workspace
